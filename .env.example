# In production, set these values in Render's environment variable UI instead
# of using this file. DB_SSL_CA accepts PEM text with escaped newline sequences
# or real line breaks.
PORT=3000
DB_HOST=your-aiven-hostname
DB_PORT=13826
DB_USER=avnadmin
DB_PASSWORD=your-password
DB_NAME=foodboxx
DB_CONNECTION_LIMIT=5
DB_SSL_CA=your-ca-certificate
NODE_ENV=production
JWT_SECRET=change-me-to-a-strong-secret
CORS_ORIGIN=http://localhost:3000
PAYMENT_SIMULATED_DELAY_MS=1500
BCRYPT_ROUNDS=10
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=FoodBoxx <no-reply@example.com>
PAYFAST_MERCHANT_ID=your-test-merchant-id
PAYFAST_MERCHANT_KEY=your-test-merchant-key
PAYFAST_PASSPHRASE=your-passphrase
PAYFAST_SANDBOX=true
BASE_URL=http://localhost:3000
